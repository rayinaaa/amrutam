  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Request Rate (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} - {{status_code}}"
        }
      ]
    },
    {
      "title": "p95 & p99 Latency (Target: Reads <200ms, Writes <500ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)"
        }
      ]
    },
    {
      "title": "Total Consultations by Status",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(telemedicine_consultations_total) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Booking Concurrency Conflicts Caught & Prevented",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "telemedicine_booking_conflicts_total",
          "legendFormat": "Conflicts Prevented"
        }
      ]
    },
    {
      "title": "Active Consultations in Progress",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "telemedicine_active_consultations",
          "legendFormat": "Active Sessions"
        }
      ]
    },
    {
      "title": "Cache Hit vs Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(cache_hits_total[1m])",
          "legendFormat": "Cache Hits/sec"
        },
        {
          "expr": "rate(cache_misses_total[1m])",
          "legendFormat": "Cache Misses/sec"
        }
      ]
    },
    {
      "title": "Node.js Process Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total"
        }
      ]
    }
  ],
  "refresh": "5s",
