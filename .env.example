# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=AmrutamTelemedicineBackend

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars!
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production!
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex for AES-256-GCM

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://amrutam_user:amrutam_secret_pw@localhost:5432/amrutam_telemedicine
DB_HOST=localhost
DB_PORT=5432
DB_USER=amrutam_user
DB_PASSWORD=amrutam_secret_pw
DB_NAME=amrutam_telemedicine
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_SSL=false

# In-Memory / Redis Cache & Locks
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Observability
LOG_LEVEL=info
ENABLE_PROMETHEUS=true
OTEL_SERVICE_NAME=amrutam-telemedicine-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
